# Modelo do arquivo .env. Copie para ".env" (na raiz) e preencha.
# O .env de verdade NUNCA vai para o Git (está no .gitignore).
# Salve em UTF-8 SEM BOM, senão a primeira variável é ignorada.

# Banco na nuvem (Turso). Sem estas duas, a API usa o arquivo local tarefas.db.
# URL: copie do painel do Turso, sem barra "/" no final.
TURSO_URL=libsql://seu-banco-seu-usuario.turso.io
TURSO_TOKEN=cole-aqui-o-token-que-comeca-com-eyJ

# Segredo que assina os tokens de login. Use um texto longo e aleatório.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Porta do servidor (opcional, padrão 3000)
PORT=3000
