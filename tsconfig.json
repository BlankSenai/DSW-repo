{
    "compilerOptions": {
        "noEmit": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "esnext",
        "strict": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "types": [
            "node"
        ]
    },
    "include": [
        "server.ts"
    ]
}
